# Optional for local exploration. When set, the demo ledger uses Neon Postgres through Prisma.
# Without it, development uses the clearly labeled process-memory fallback.
DATABASE_URL=

# Required to sign in to the private merchant desk. Generate the hash with `npm run owner:hash`.
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
# Generate with `openssl rand -hex 32` (or an equivalent secure random generator).
SESSION_SECRET=

# Optional for AI incident explanations and customer reply drafts; templates are used without a key.
GROQ_API_KEY=
# Optional model overrides. Defaults: openai/gpt-oss-20b and openai/gpt-oss-120b.
GROQ_MODEL=
GROQ_FALLBACK_MODEL=

# Optional direct delivery for admin merchant incident emails via Resend (server-only; never prefix with NEXT_PUBLIC_).
# Use a Resend API key and a sender address/domain verified in your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL="PayProof Alerts <alerts@example.com>"

# Required to enable authenticated agent checkout and POST /api/connector/events.
CONNECTOR_SHARED_SECRET=

# Braintree Sandbox API credentials.
# Create a sandbox account in the Braintree Control Panel and copy its API keys.
BRAINTREE_ENVIRONMENT=sandbox
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=

