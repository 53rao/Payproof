generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             String             @id
  name           String
  priceCents     Int                @map("price_cents")
  simulated      Boolean            @default(true)
  merchantId     String             @default("northstar") @map("merchant_id")
  merchant       Merchant           @relation(fields: [merchantId], references: [id])
  orderItems     OrderItem[]

  @@map("products")
}

model Merchant {
  id           String           @id
  name         String
  email        String?          @unique(map: "merchants_email_unique")
  passwordHash String?          @map("password_hash")
  simulated    Boolean          @default(true)
  products     Product[]
  agentActions AgentActionLog[]

  @@map("merchants")
}

model AgentActionLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type       String
  merchantId String   @map("merchant_id")
  detail     String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([createdAt])
  @@map("agent_action_logs")
}

model SimulationDiagnosis {
  id                String   @id @default(cuid())
  simulationId      String   @unique @map("simulation_id")
  merchantId        String   @map("merchant_id")
  patternDetected   String   @map("pattern_detected") @db.Text
  likelyCause       String   @map("likely_cause") @db.Text
  evidence          Json
  hypothesis        String   @db.Text
  recommendedAction String   @map("recommended_action") @db.Text
  confidence        String
  confidenceReason  String   @map("confidence_reason") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("simulation_diagnoses")
}

model Owner {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique(map: "owners_email_unique")
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  aiDrafts     AiDraft[]

  @@map("owners")
}

model Order {
  id                      String              @id
  idempotencyKey          String              @unique(map: "orders_idempotency_key_unique") @map("idempotency_key")
  cartFingerprint         String              @map("cart_fingerprint")
  totalCents              Int                 @map("total_cents")
  status                  OrderStatus         @default(PENDING)
  simulated               Boolean             @default(true)
  checkoutOrigin          CheckoutOrigin      @default(UNKNOWN) @map("checkout_origin")
  customerAccessTokenHash String?             @map("customer_access_token_hash")
  recoveredFromOrderId    String?             @map("recovered_from_order_id")
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  items                   OrderItem[]
  paymentEvents           PaymentEvent[]
  cases                   Case[]
  complaints              CustomerComplaint[]

  @@map("orders")
}

model OrderItem {
  orderId        String  @map("order_id")
  productId      String  @map("product_id")
  quantity       Int
  unitPriceCents Int     @map("unit_price_cents")
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "order_items_order_id_orders_id_fk")
  product        Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_items_product_id_products_id_fk")

  @@id([orderId, productId], map: "order_items_order_id_product_id_pk")
  @@map("order_items")
}


model PaymentEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String   @map("order_id")
  type          String
  paymentStatus String?  @map("payment_status")
  issue         String?
  debugId       String?  @map("debug_id")
  rawJson       Json     @default("{}") @map("raw_json")
  simulated     Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payment_events_order_id_orders_id_fk")
  liveScan      LiveTransactionScan?

  @@map("payment_events")
}

model LiveTransactionScan {
  eventId  String       @id @map("event_id") @db.Uuid
  scanJson Json         @map("scan_json")
  scannedAt DateTime    @default(now()) @map("scanned_at") @db.Timestamptz(6)
  event    PaymentEvent @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("live_transaction_scans")
}

model IncidentState {
  id              String    @id
  type            String
  merchantId      String    @map("merchant_id")
  firstDetectedAt DateTime  @map("first_detected_at") @db.Timestamptz(6)
  lastSeenAt      DateTime  @map("last_seen_at") @db.Timestamptz(6)
  active          Boolean   @default(true)
  action          String?
  actedAt         DateTime? @map("acted_at") @db.Timestamptz(6)
  actedBy         String?   @map("acted_by")

  @@index([active, lastSeenAt])
  @@map("incident_states")
}

model Case {
  id                  String             @id
  orderId             String             @map("order_id")
  type                String
  status              CaseStatus         @default(OPEN)
  cause               String
  uncertainty         String
  simulated           Boolean            @default(true)
  agentHandled        Boolean            @default(false) @map("agent_handled")
  humanReviewRequired Boolean            @default(false) @map("human_review_required")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cases_order_id_orders_id_fk")
  items               CaseItem[]
  drafts              AiDraft[]
  complaint           CustomerComplaint?
  report              EvidenceReport?

  @@map("cases")
}

model CustomerComplaint {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String   @map("order_id")
  caseId       String   @unique(map: "customer_complaints_case_id_unique") @map("case_id")
  type         String
  originalText String   @map("original_text") @db.Text
  simulated    Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_complaints_order_id_orders_id_fk")
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_complaints_case_id_cases_id_fk")

  @@index([orderId, createdAt])
  @@map("customer_complaints")
}

model EvidenceReport {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId    String   @unique(map: "evidence_reports_case_id_unique") @map("case_id")
  body      String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "evidence_reports_case_id_cases_id_fk")

  @@map("evidence_reports")
}

model CaseItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId       String   @map("case_id")
  kind         String
  referenceId  String?  @map("reference_id")
  completeness String
  payload      Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "case_items_case_id_cases_id_fk")

  @@map("case_items")
}

model AiDraft {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId     String    @map("case_id")
  kind       String
  body       String
  approvedBy String?   @map("approved_by") @db.Uuid
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(6)
  simulated  Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  case       Case      @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ai_drafts_case_id_cases_id_fk")
  owner      Owner?    @relation(fields: [approvedBy], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "ai_drafts_approved_by_owners_id_fk")

  @@map("ai_drafts")
}

model DemoRun {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)
  simulated Boolean   @default(true)

  @@map("demo_runs")
}

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  FAILED

  @@map("order_status")
}

enum CaseStatus {
  OPEN
  REVIEWED
  CLOSED

  @@map("case_status")
}

enum CheckoutOrigin {
  AGENT
  HUMAN
  UNKNOWN

  @@map("checkout_origin")
}
